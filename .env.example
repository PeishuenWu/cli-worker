# Synology Chat Outgoing webhook token (required)
SYNCHAT_OUTGOING_TOKEN=

# Synology Chat Incoming webhook URL (recommended)
SYNCHAT_INCOMING_URL=

# URL Base for file serving (required for file uploads, e.g., http://your-ip:8090)
SYNCHAT_FILE_URL_BASE=

# Optional: Default Chat ID for notifications
DEFAULT_CHAT_ID=

# Server Configuration
CHAT_BRIDGE_PORT=8090
CHAT_BRIDGE_PATH=/synology/chat/outgoing

# Codex Configuration
CODEX_BIN=codex
CODEX_WORKDIR=/home/codex/workspace
CODEX_MODEL=
CODEX_SANDBOX_MODE=workspace-write
CODEX_BYPASS_SANDBOX=false
CODEX_TIMEOUT_MS=600000
CODEX_STALE_TIMEOUT_MS=60000
CODEX_HEARTBEAT_INTERVAL_MS=30000
MAX_REPLY_CHARS=1800
CODEX_SYSTEM_PROMPT=

# Ollama Vision Configuration
VISION_MODEL=qwen2-vl
OLLAMA_API_URL=http://127.0.0.1:11434

# Timeouts and Performance
TASK_CONCURRENCY=2
TASK_QUEUE_MAX=200

# Container/system timezone
TZ=Asia/Taipei

# Memory system
MEMORY_ENABLE=true
MEMORY_BACKEND=qdrant
MEMORY_PROJECT=codex_worker
MEMORY_TOP_K=5
MEMORY_SCORE_THRESHOLD=0.35
MEMORY_SHORT_TTL_DAYS=14

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=codex_memory

# Embedding provider
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Fallback storage when vector mode unavailable
MEMORY_FALLBACK_FILE=/home/codex/.codex/memory/fallback.jsonl

# Chat Context
CHAT_CONTEXT_ENABLE=true
CHAT_CONTEXT_DB_PATH=/home/codex/.codex/chat_context/context.sqlite
CHAT_CONTEXT_MAX_MESSAGES=10

# Scheduler
SCHEDULER_ENABLE=true
SCHEDULER_DB_PATH=/home/codex/.codex/scheduler/jobs.sqlite
SCHEDULER_TICK_SECONDS=30
SCHEDULER_CLAIM_LIMIT=3
SCHEDULER_MAX_RETRIES=3
SCHEDULER_RETRY_BASE_SECONDS=60
SCHEDULER_DEFAULT_TIMEZONE=Asia/Taipei
SCHEDULER_ALLOWED_USERS=
SCHEDULER_ALLOWED_CHANNELS=
SCHEDULER_ADMIN_USERS=
SCHEDULER_MAX_ACTIVE_PER_USER=10
SCHEDULER_MAX_ACTIVE_PER_CHANNEL=50
SCHEDULER_RETENTION_DAYS=30
SCHEDULER_CLEANUP_SECONDS=3600

# Admin UI (internal network, no login)
ADMIN_UI_ENABLE=true
ADMIN_UI_PATH=/admin
ADMIN_AUTH_TOKEN=
ADMIN_UI_MEMORY_LIMIT=50
ADMIN_UI_SCHEDULE_LIMIT=100
